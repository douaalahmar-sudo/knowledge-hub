# Pins peer-dependency resolution for BOTH local installs and CI.
#
# Without this, `npm ci` computes a different ideal tree than the committed
# lockfile and fails with EUSAGE on chokidar/readdirp/glob-parent/picomatch.
# The lockfile was generated with legacy peer resolution, and this file makes
# every machine agree — previously it only worked locally because a personal
# ~/.npmrc set it, which CI never sees.
legacy-peer-deps=true