# Monorepo-root copy of frontend/.npmrc.
#
# npm reads a project .npmrc from the CURRENT WORKING DIRECTORY. Cloudflare's
# build runs `npm clean-install` and did not pick up frontend/.npmrc, so this
# root copy covers the case where the install runs from the repository root.
#
# Why it is needed at all: under stock settings, npm (both 10.9.2 and 11.8.0)
# generates a lockfile that its own `npm ci` then rejects with EUSAGE on
# chokidar/readdirp/glob-parent/picomatch. Verified on Linux — the only
# configuration where `npm ci` succeeds is legacy peer resolution.
legacy-peer-deps=true